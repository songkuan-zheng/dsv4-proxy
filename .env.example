# ---- server ----
PORT=8002
UPSTREAM=http://sglang-router:8000

# ---- reasoning_effort injection ----
# SGLang treats a missing reasoning_effort as "none" — no thinking at all — so a
# default is injected for clients that do not set one. "off" disables.
DEFAULT_REASONING_EFFORT=max
# 1 = also overwrite what the client sent
REASONING_EFFORT_OVERRIDE=1

# ---- reasoning_content backfill (the main fix) ----
BACKFILL_REASONING=1
# 0 = repair every tool-calling turn, which is what DeepSeek's spec requires
BACKFILL_MAX_TURNS=0

# ---- L2 cache: Redis ----
# Empty disables it; the proxy then keeps an in-process cache only, which does
# not survive a restart.
REASONING_REDIS_URL=redis://dsv4-redis:6379
# Idle timeout, not session length: reads are GETEX and renew it.
REASONING_REDIS_TTL_SEC=86400
REASONING_REDIS_PREFIX=dsv4:rc:

# ---- encryption at rest ----
# The cache holds the model's reasoning about your codebase. Generate a key with
#   openssl rand -hex 32
# and point this at the file. Prefer the file form: an inline
# REASONING_CACHE_KEY would show up in `docker inspect`.
REASONING_CACHE_KEY_FILE=/run/secrets/cache.key

# ---- loop scrubbing ----
SCRUB_ASSISTANT_LOOPS=1
# 8 matches the detection heuristic reported upstream; 3 was too eager and
# flagged markdown code fences.
SCRUB_MIN_REPEATS=8
SCRUB_MIN_UNIT_CHARS=12
SCRUB_MAX_UNIT_CHARS=200
LOOP_FREQUENCY_PENALTY=0.1

# ---- deadlock backstop ----
# Wording matters: "what to do next" keeps the agent loop, whereas "before
# answering, reason step by step" makes the model stop calling tools.
TOOL_RESULT_NUDGE=Think carefully about what to do next before responding.
NUDGE_CONSECUTIVE=3
NUDGE_MIN_TURNS=10

# ---- observability ----
# One [effort] line per request and response: counters only, never content.
LOG_REASONING=1
DEBUG=0

# ---- diagnostics (all print real content; keep off unless investigating) ----
# DUMP_REQUEST=struct        request shape + think-pattern, no text
# DUMP_PREVIEW_CHARS=600     add leading chars of head/tail messages
# DUMP_RESPONSE_CHARS=1800   what the model reasoned and wrote
# DUMP_BACKFILL_CHARS=220    which key each restored trace came from
# DUMP_SCRUB_CHARS=160       which repeated units were removed
